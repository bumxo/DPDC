# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required by the seed script (scripts/seed.ts). Never expose
# this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute URL of this app, used to build the links sent in verification and
# password-reset emails. Optional locally (the request host is used instead),
# but set it in production, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Seed account credentials (used by scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password-123
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=customer-password-123
